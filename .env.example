# Copy to .env.local for local development. In Vercel, add these under
# Project → Settings → Environment Variables. Never commit real values.

# Public site address, no trailing slash. Used for canonical URLs, sitemap,
# Open Graph images and auth email links.
NEXT_PUBLIC_SITE_URL=https://inspirelincoln.uk

# Supabase → Project Settings → API. The anon key is public by design;
# row level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Optional: account deletion also works without it through a
# database function. Never prefix with NEXT_PUBLIC_ and never paste it anywhere public.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (https://resend.com): account decisions, submission feedback, group
# emails from the committee dashboard and contact form notifications. Without
# these the site still works, but none of those emails are sent.
RESEND_API_KEY=
EMAIL_FROM="INSPIRE <noreply@inspirelincoln.uk>"
CONTACT_TO_EMAIL=

# Where Supabase stores the data, shown in the privacy notice, e.g. "London (eu-west-2)".
NEXT_PUBLIC_DATA_REGION=

# Optional: public contact address shown on the site.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional: set to "true" only if you add non-essential cookies (e.g.
# analytics). Shows the consent banner. The site sets no such cookies today.
NEXT_PUBLIC_OPTIONAL_COOKIES=false
